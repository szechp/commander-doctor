+    /** Battlebox analysis hook: at the active player's end step, log their hand, untapped lands and board. */
+    public static class SnapshotLogger {
+        private final Game game;
+        SnapshotLogger(Game game) { this.game = game; }
+
+        private static String tag(Card c) {
+            String t = c.isLand() ? "L" : c.isCreature() ? "C" : c.isInstant() ? "I" : c.isSorcery() ? "S"
+                    : c.isPlaneswalker() ? "P" : c.isEnchantment() ? "E" : c.isArtifact() ? "A" : "?";
+            return c.getName() + "|" + c.getCMC() + "|" + t;
+        }
+
+        @Subscribe
+        public void onPhase(GameEventTurnPhase ev) {
+            if (ev.phase() != PhaseType.END_OF_TURN) return;
+            int turn = game.getPhaseHandler().getTurn();
+            for (Player p : game.getPlayers()) {
+                int lands = 0, untapped = 0;
+                List<String> board = new ArrayList<>();
+                for (Card c : p.getCardsIn(ZoneType.Battlefield)) {
+                    if (c.isLand()) { lands++; if (!c.isTapped()) untapped++; }
+                    else board.add(tag(c));
+                }
+                List<String> hand = new ArrayList<>();
+                for (Card c : p.getCardsIn(ZoneType.Hand)) hand.add(tag(c));
+                boolean active = p.getName().equals(ev.playerTurn().getName());
+                game.getGameLog().add(GameLogEntryType.INFORMATION, "SNAP T" + turn + (active ? " ACTIVE " : " OTHER ")
+                        + p.getName() + " :: life=" + p.getLife() + " lands=" + lands + " untapped=" + untapped
+                        + " landdrops=" + p.getLandsPlayedThisTurn() + " lib=" + p.getCardsIn(ZoneType.Library).size()
+                        + " gy=" + p.getCardsIn(ZoneType.Graveyard).size()
+                        + " hand=" + String.join(";", hand) + " board=" + String.join(";", board));
+            }
+        }
+    }
+
